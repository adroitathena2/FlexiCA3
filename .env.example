# Paytriq environment template
#
# Copy to `.env` and fill in what you have. NOTHING here is required to run the
# system: with every value blank Paytriq still runs, degrading honestly to the
# deterministic `rules` decision backend and fixture-backed tools. Every
# degradation is recorded in the execution trace with its source, so a blank
# file produces a *less capable but truthful* run rather than a fake one.
#
#   cp .env.example .env

# ---------------------------------------------------------------- run mode
# live   = call real models (default)
# replay = replay a recorded transcript from tests/golden/replay.jsonl (no network)
# offline= rules backend only, no model calls at all
RUN_MODE=live
ENVIRONMENT=local

# ------------------------------------------------------- provenance (for traces)
# Every trace carries these, so a trace can be tied to an exact commit.
# Set them in CI, or via:  git rev-parse HEAD
GIT_COMMIT=unknown
CODE_SHA256=unknown

# ------------------------------------------------------- generative model (Gemini)
# Reasoning, drafting, negotiation language, free-text judgement.
# Free tier: https://aistudio.google.com/apikey
#
# IMPORTANT: since 2026-06-19 Google rejects requests from unrestricted API keys.
# Restrict the key to the Generative Language API:
#   Google Cloud console -> APIs & Services -> Credentials -> "API restrictions"
#   -> restrict to "Generative Language API" (generativelanguage.googleapis.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=45

# ------------------------------------------------- decision model (Clef / System One)
# Calibrated decisions: routing, escalation thresholds, fit scoring, compliance.
#
# LOCAL OPTION (recommended for demos -- offline, no rate limit, no cost).
# Requires llama.cpp >= b11364 with the `clef` architecture, serving the
# open-weight GGUF from https://huggingface.co/ggml-org/Clef-Flash-GGUF
#   llama-server.exe -m Clef-Flash-Q4_K_M.gguf -ngl 99 -c 4096 -ub 4096 --port 18781
# The endpoint is POST /v1/systemone -- NOT /v1/chat/completions.
#
# Do NOT use Ollama for clef on Windows: ollama/ollama#18769 (32-bit file-offset
# truncation in ifstream causes non-finite logits). Fix PR #18777 unmerged as of
# 2026-10-04.
CLEF_BACKEND=ollama
CLEF_BASE_URL=http://localhost:18781
CLEF_MODEL=clef-flash
CLEF_TIMEOUT_S=5
CLEF_HEALTH_TTL_S=30

# CLOUD OPTION (for the deployed demo, where no local GPU exists).
# CLEF_BACKEND=workers_ai
# CLEF_ACCOUNT_ID=
# CLEF_API_KEY=

# ------------------------------------------------------------ decision layer
# auto  = prefer clef, then gemini, then rules (recommended)
# clef | gemini | rules = pin to one
DECISION_BACKEND=auto
# Below this, the arbiter escalates to a human instead of deciding.
CONFIDENCE_THRESHOLD=0.62
# Below this, escalate rather than fall back to a generative model.
ESCALATION_THRESHOLD=0.40
DECISION_MAX_RETRIES=1

# --------------------------------------------------------------- agent budgets
AGENT_STEP_BUDGET=6
AGENT_DEADLINE_S=60
MAX_DEBATE_ROUNDS=2
MAX_REPLANS=2
MAX_AUCTION_ROUNDS=3

# ----------------------------------------------------------------------- tools
# tools_live=false (default) serves labelled fixtures and marks every result
# degraded. tools_live=true makes real Overpass/Nominatim/Resend calls.
TOOLS_ENABLED=true
TOOLS_LIVE=false
TOOL_TIMEOUT_S=20
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Overpass blocks default user agents. Identify yourself.
MAP_USER_AGENT=paytriq-research/0.1 (student project)
# Optional: real email delivery. Without it, mail is spooled to artifacts/outbox/
# and reported as NOT delivered.
RESEND_API_KEY=
EMAIL_FROM=paytriq@example.invalid

# ------------------------------------------------------- human-in-the-loop gates
# Gate flow: A3 (outreach) and A4 (contract/MoU release) park at a human gate
# instead of acting. The API answers 403 {gated:true} with a gate_id; a human
# answers with POST /api/gates/{gate_id} {outcome: approve|reject|revise}.
# The answer writes a HumanDecision + Approval row authorising exactly one
# action kind, and the parked stage is retried/resumed to proceed.
# true  = gates block and wait for a decision (use this for the live demo)
# false = gates auto-resolve with AUTO_APPROVE_OUTCOME. Auto-resolutions are
#         recorded with decided_by="auto" so they are never mistaken for a human.
HUMAN_GATES_INTERACTIVE=true
AUTO_APPROVE_OUTCOME=approve
